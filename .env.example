# .env.example → .env.local 로 복사해서 채운다. 모든 값은 서버(Vercel Functions)에서만 읽는다.
# 비워 둔 항목은 해당 기능이 폴백(목업·기본 계산)으로 동작할 뿐, 앱은 멈추지 않는다.

# [권장] OpenAI — 의도 분석·송금안·서류 분석. 없으면 모든 에이전트가 코드 폴백으로 동작
OPENAI_API_KEY=sk-proj-...

# [선택] 한국수출입은행 OpenAPI (oapi.koreaexim.go.kr) — 없으면 목업 환율·기준금리
#   FX   : 현재환율 exchangeJSON?data=AP01
#   LEND : 대출금리 interestJSON?data=AP02 (수은채 유통수익률 커브)
#   두 데이터셋에 같은 키를 쓴다면 KOREAEXIM_API_KEY 하나만 채워도 된다
KOREAEXIM_FX_KEY=
KOREAEXIM_LEND_KEY=
KOREAEXIM_API_KEY=

# [선택] Supabase — 서류 에이전트의 문서 Vector DB(RAG). 없으면 "안내 자료 없음"으로 진행
#   런타임은 publishable 키로 RPC 두 개만 부른다 (supabase/migrations/001_guides.sql)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# [스크립트 전용] 마이그레이션·안내 자료 적재 — Vercel 에는 올리지 않는다
#   Supabase 대시보드 → Connect → Transaction pooler 주소 (Direct 주소는 IPv6 전용이라 안 붙을 수 있다)
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
