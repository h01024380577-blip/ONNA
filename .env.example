# 서버(Vercel Functions) 전용 — 브라우저에 노출되지 않음
OPENAI_API_KEY=sk-proj-...

# 한국수출입은행 OpenAPI — 데이터셋별 인증키 (oapi.koreaexim.go.kr)
#   FX   : 현재환율   exchangeJSON?data=AP01
#   LEND : 대출금리   interestJSON?data=AP02  (수은채 유통수익률 커브)
#   INT  : 국제금리   rateJSON?data=AP03      (LIBOR/SOFR/EURIBOR/CIRR) — 승인 필요
KOREAEXIM_FX_KEY=
KOREAEXIM_LEND_KEY=
KOREAEXIM_INT_KEY=
